# ── API / Backend ─────────────────────────────────────────────────────────
# Set this to your backend base URL, e.g. https://api.zuzumik.com
# (leave empty to hit the same origin / relative /api/v1 routes)
NEXT_PUBLIC_API_URL=

# "true"  → use bundled mock data (default)
# "false" → hit the real backend (each service flips to real API calls)
NEXT_PUBLIC_API_MOCK=true

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zuzumik.com
NEXT_PUBLIC_SITE_NAME=Zuzumik

# ── Firebase Auth (optional) ───────────────────────────────────────────────
# Set these to enable Google & Phone sign-in
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=